# Copy to .env and adjust. .env is git-ignored because it names a host and may
# hold a sudo password.

# SSH target of the appliance, as user@host.
LASERBRIDGE_SSH=laserbridge@laserbridge.local

# Private key for that connection. Optional; the SSH agent or the default
# identity is used when this is unset.
#LASERBRIDGE_SSH_KEY=~/.ssh/laserbridge_ed25519

# Public key authorized inside the RAM system. A RAM boot starts with an empty
# /data, so without this the operator cannot log in after the kexec. Defaults
# to LASERBRIDGE_SSH_KEY.pub, then to ~/.ssh/id_ed25519.pub.
#LASERBRIDGE_PUBKEY=~/.ssh/laserbridge_ed25519.pub

# Only needed when the target is a foreign Linux whose sudo asks for a
# password. LaserBridgeOS itself uses a passwordless doas rule scoped to the
# deployment helper, and has password authentication disabled.
#LASERBRIDGE_PASSWORD=CHANGE_ME

# Target disk for --install. Required only when the device has more than one
# fixed disk; deploy.sh lists the candidates when it cannot decide.
#LASERBRIDGE_DISK=/dev/mmcblk0

# Where the RAM system answers, if DHCP hands it a different address than the
# installed system uses. Defaults to LASERBRIDGE_SSH.
#LASERBRIDGE_RECOVERY_SSH=laserbridge@192.168.178.8
