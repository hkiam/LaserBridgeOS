#!/sbin/openrc-run
# shellcheck shell=sh
# shellcheck disable=SC2034

description="LaserBridgeOS GRBL serial to raw TCP bridge"
command="/usr/sbin/laserbridged"
command_user="root:root"
supervisor="supervise-daemon"
respawn_delay=3
respawn_max=0
output_logger="logger -t laserbridged"
error_logger="logger -t laserbridged"

depend() {
	need laserbridge-init
	after devfs mdev networking laserbridge-network
}

start_pre() {
	# Only one backend may own the serial port. ser2net asks the same
	# question and gets the opposite answer.
	/usr/sbin/laserbridge grbl-backend laserbridged
}
