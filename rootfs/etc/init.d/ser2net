#!/sbin/openrc-run
# shellcheck shell=sh
# shellcheck disable=SC2034

description="LaserBridgeOS GRBL serial to raw TCP bridge"
command="/usr/sbin/ser2net"
command_args="-n -c /run/laserbridge/ser2net.yaml"
command_user="root:root"
supervisor="supervise-daemon"
respawn_delay=3
respawn_max=0
output_logger="logger -t ser2net"
error_logger="logger -t ser2net"

depend() {
	need laserbridge-init
	# gensio resolves the listening address at startup, which fails while no
	# interface has one yet. supervise-daemon retries and the bridge comes up
	# a few seconds later, but starting after the network avoids the alarming
	# error in the boot log and the delay that goes with it.
	after devfs mdev networking laserbridge-network
}
