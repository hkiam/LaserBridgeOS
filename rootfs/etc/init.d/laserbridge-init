#!/sbin/openrc-run
# shellcheck shell=sh
# shellcheck disable=SC2034

description="Initialize LaserBridgeOS volatile and persistent state"

depend() {
	need localmount
	before networking laserbridge-network sshd avahi-daemon ser2net ustreamer laserbridge-web
}

start() {
	ebegin "Preparing LaserBridgeOS state"
	# /data/log is where syslogd writes, and it has to exist before syslogd
	# starts - which is why syslog declares rc_need on this service.
	mkdir -p /run/laserbridge /run/lock /data/log /data/ssh /data/setup /data/home/laserbridge
	chmod 0755 /run/laserbridge /run/lock
	# Readable by the account that has to diagnose this thing. Restricting it
	# would inconvenience the one user who can log in, who can become root
	# anyway (ADR 0008) - the same reasoning that leaves dmesg unrestricted.
	chmod 0755 /data/log
	touch /run/resolv.conf
	/usr/sbin/laserbridge init || return 1
	chown -R laserbridge:laserbridge /data/home/laserbridge

	# A RAM boot has an empty /data, so the key the operator deployed with is
	# the only one that can get back in. It is authorized in addition to the
	# generated one rather than replacing it.
	if [ -f /etc/laserbridge/ramboot-authorized-keys ]; then
		cat /etc/laserbridge/ramboot-authorized-keys >> /data/ssh/authorized_keys
		sort -u -o /data/ssh/authorized_keys /data/ssh/authorized_keys
		chmod 0644 /data/ssh/authorized_keys
		einfo "Authorized the deployment key for this RAM session"
	fi
	if [ -f /etc/laserbridge/recovery ]; then
		einfo "Recovery mode: appliance services stay stopped"
	fi
	eend $?
}
